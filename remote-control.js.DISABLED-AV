// remote-control.js - Remote control of THIS machine (screenshots, shell, files, mouse/keyboard)
// Used by whatsapp-notifier.js: the owner sends /rc commands over WhatsApp and gets results back.
// Windows-only (uses PowerShell + user32). No new npm dependencies.

import { exec } from 'child_process';
import fs from 'fs';
import os from 'os';
import path from 'path';

const MAX_OUTPUT = 80000; // max bytes captured from a command

let tmpDir = null;
function getTmpDir() {
  if (!tmpDir) tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'rc-'));
  return tmpDir;
}

function writePsScript(name, content) {
  const file = path.join(getTmpDir(), name);
  fs.writeFileSync(file, content, 'utf8');
  return file;
}

function runPsFile(scriptFile, args, timeoutMs = 60000) {
  return new Promise((resolve) => {
    const cmd = `powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "${scriptFile}"${args ? ' ' + args : ''}`;
    exec(cmd, {
      windowsHide: true,
      timeout: timeoutMs,
      maxBuffer: 4 * 1024 * 1024,
      encoding: 'utf8'
    }, (err, stdout, stderr) => {
      resolve({
        success: !err || !(err.code && err.killed && err.signal === 'SIGKILL'),
        code: err && err.code ? err.code : 0,
        stdout: String(stdout || ''),
        stderr: String(stderr || ''),
        error: err && !err.code && !stdout ? String(err.message || err) : ''
      });
    });
  });
}

// ── Screenshot ──────────────────────────────────────────────────────────────
const SCREENSHOT_PS = `
Add-Type -AssemblyName System.Windows.Forms,System.Drawing
$bounds = [System.Windows.Forms.SystemInformation]::VirtualScreen
$bmp = New-Object System.Drawing.Bitmap($bounds.Width, $bounds.Height)
$g = [System.Drawing.Graphics]::FromImage($bmp)
try {
  $g.CopyFromScreen($bounds.Left, $bounds.Top, 0, 0, $bmp.Size)
  $bmp.Save($args[0], [System.Drawing.Imaging.ImageFormat]::Png)
  Write-Output "OK:$($bounds.Width)x$($bounds.Height)"
} catch {
  Write-Error "SCREENSHOT_FAILED: $_"
} finally {
  $g.Dispose(); $bmp.Dispose()
}
`;

export async function captureScreenshot() {
  const outFile = path.join(getTmpDir(), `shot-${Date.now()}.png`);
  const script = writePsScript('screenshot.ps1', SCREENSHOT_PS);
  const result = await runPsFile(script, `"${outFile}"`, 30000);
  if (!result.stdout.includes('OK:') && !fs.existsSync(outFile)) {
    return { success: false, error: result.stderr || result.error || 'فشل أخذ السكرين شوت' };
  }
  return { success: true, file: outFile };
}

// ── Shell commands ──────────────────────────────────────────────────────────
export function runShell(command, timeoutMs = 60000) {
  return new Promise((resolve) => {
    exec(`cmd.exe /d /s /c "chcp 65001 > nul & ${command}"`, {
      windowsHide: true,
      timeout: timeoutMs,
      maxBuffer: MAX_OUTPUT,
      encoding: 'utf8'
    }, (err, stdout, stderr) => {
      let out = String(stdout || '').trim();
      let errOut = String(stderr || '').trim();
      if (err) {
        if (err.killed) out += '\n[تم إيقاف الأمر — تجاوز الوقت]';
        else if (!out && errOut) out = errOut.length > out.length ? errOut : out;
        if (err.code) errOut += errOut ? `\n(Exit code: ${err.code})` : `(Exit code: ${err.code})`;
      }
      resolve({
        success: !err,
        code: err && err.code !== undefined ? err.code : 0,
        output: out || errOut || '(لا يوجد مخرجات)',
        error: err && !errOut ? String(err.message || err) : ''
      });
    });
  });
}

// ── Windows PowerShell (advanced) ──────────────────────────────────────────
export async function runPowerShell(script, timeoutMs = 60000) {
  const psFile = writePsScript(`ps-${Date.now()}.ps1`, script);
  const result = await runPsFile(psFile, '', timeoutMs);
  const out = result.stdout.trim() || result.stderr.trim() || '(لا يوجد مخرجات)';
  return { success: result.code === 0 || !!result.stdout.trim(), code: result.code, output: out, error: result.error };
}

// ── Files ───────────────────────────────────────────────────────────────────
const IGNORED_DIRS = new Set(['$RECYCLE.BIN', 'System Volume Information', 'node_modules', '.git', '__pycache__']);

export function listDirectory(dir) {
  const target = dir && dir.trim() ? dir.trim() : os.homedir();
  try {
    const stats = fs.statSync(target);
    if (!stats.isDirectory()) {
      const f = path.basename(target);
      return { error: false, path: target, singleFile: { name: f, size: stats.size, isDir: false } };
    }
    const entries = fs.readdirSync(target, { withFileTypes: true })
      .filter(e => !IGNORED_DIRS.has(e.name))
      .sort((a, b) => {
        if (a.isDirectory() !== b.isDirectory()) return a.isDirectory() ? -1 : 1;
        return a.name.localeCompare(b.name, 'en');
      });
    const lines = entries.map(e => {
      let sizeTxt = '';
      if (!e.isDirectory()) {
        try { sizeTxt = '  ' + formatSize(fs.statSync(path.join(target, e.name)).size); } catch (_) {}
      }
      return (e.isDirectory() ? '📁 ' : '📄 ') + e.name + sizeTxt;
    });
    const head = `📍 ${target}\n${'─'.repeat(50)}\n`;
    const body = lines.join('\n');
    return {
      error: false,
      path: target,
      text: head + body + (lines.length ? '\n' : '\n(فارغ)'),
      maxText: head.length + body.length <= 3800
    };
  } catch (e) {
    return { error: true, message: `⚠️ ${target}: ${e.code === 'ENOENT' ? 'المسار غير موجود' : String(e.message || e)}` };
  }
}

export function fileInfo(p) {
  try {
    const stats = fs.statSync(p);
    if (!stats.isFile()) return { error: true, message: '⚠️ ده مش ملف (جرب /rc ls)' };
    return { error: false, path: p, name: path.basename(p), size: stats.size };
  } catch (e) {
    return { error: true, message: `⚠️ ${p}: ${e.code === 'ENOENT' ? 'الملف غير موجود' : String(e.message || e)}` };
  }
}

function formatSize(bytes) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

// ── Mouse ───────────────────────────────────────────────────────────────────
const MOUSE_PS = `
param($x, $y, $mode)
Add-Type @"
using System;
using System.Runtime.InteropServices;
public class M {
  [DllImport("user32.dll")] public static extern bool SetCursorPos(int X, int Y);
  [DllImport("user32.dll")] public static extern void mouse_event(uint flags, uint dx, uint dy, uint data, UIntPtr extra);
}
"@
[M]::SetCursorPos($x, $y)
Start-Sleep -Milliseconds 50
$mode = $mode.ToLower()
if ($mode -eq "right") {
  [M]::mouse_event(0x0008,0,0,0,[UIntPtr]::Zero)
  [M]::mouse_event(0x0010,0,0,0,[UIntPtr]::Zero)
} elseif ($mode -eq "double") {
  [M]::mouse_event(0x0002,0,0,0,[UIntPtr]::Zero); [M]::mouse_event(0x0004,0,0,0,[UIntPtr]::Zero)
  Start-Sleep -Milliseconds 80
  [M]::mouse_event(0x0002,0,0,0,[UIntPtr]::Zero); [M]::mouse_event(0x0004,0,0,0,[UIntPtr]::Zero)
} else {
  [M]::mouse_event(0x0002,0,0,0,[UIntPtr]::Zero)
  [M]::mouse_event(0x0004,0,0,0,[UIntPtr]::Zero)
}
Write-Output "OK: $x,$y ($mode)"
`;

function sendKeys(text, warn) {
  return runPowerShell(`
Add-Type -AssemblyName System.Windows.Forms
[System.Windows.Forms.SendKeys]::SendWait('${escapeSingleQuote(text)}')
Write-Output "OK"
`, 10000);
}

function escapeSingleQuote(s) { return String(s).replace(/'/g, "''").replace(/\r?\n/g, '{ENTER}'); }

function escapeSendKeys(s) {
  return String(s)
    .replace(/\+/g, '{+}').replace(/\^/g, '{^}').replace(/%/g, '{%}')
    .replace(/~/g, '{~}').replace(/\(/g, '{(}').replace(/\)/g, '{)}')
    .replace(/\{/g, '{{}').replace(/\}/g, '{}}').replace(/\[/g, '{[}').replace(/\]/g, '{]}');
}

export async function mouseClick(x, y, mode = 'click') {
  const script = writePsScript('mouse.ps1', MOUSE_PS);
  const result = await runPsFile(script, `${x} ${y} ${mode}`, 15000);
  return { ...result, output: result.stdout.trim() || 'OK' };
}

export async function typeText(text) {
  return sendKeys(escapeSendKeys(text));
}

const KEY_MAP = {
  enter: '{ENTER}', tab: '{TAB}', esc: '{ESC}', escape: '{ESC}',
  back: '{BACKSPACE}', backspace: '{BACKSPACE}', delete: '{DELETE}', del: '{DELETE}',
  space: '{SPACE}', ' ': '{SPACE}', home: '{HOME}', end: '{END}',
  up: '{UP}', down: '{DOWN}', left: '{LEFT}', right: '{RIGHT}',
  pageup: '{PGUP}', pagedown: '{PGDN}', pgup: '{PGUP}', pgdn: '{PGDN}',
  capslock: '{CAPSLOCK}', numlock: '{NUMLOCK}', scrolllock: '{SCROLLLOCK}',
  f1: '{F1}', f2: '{F2}', f3: '{F3}', f4: '{F4}', f5: '{F5}', f6: '{F6}',
  f7: '{F7}', f8: '{F8}', f9: '{F9}', f10: '{F10}', f11: '{F11}', f12: '{F12}',
  ctrl: '^', control: '^', alt: '%', shift: '+', win: '^{ESC}',
  'ctrl+c': '^c', 'ctrl+v': '^v', 'ctrl+x': '^x', 'ctrl+a': '^a', 'ctrl+z': '^z', 'ctrl+y': '^y',
  'ctrl+s': '^s', 'ctrl+f': '^f', 'ctrl+p': '^p', 'ctrl+tab': '^{TAB}',
  'alt+tab': '%{TAB}', 'alt+f4': '%{F4}',
  'ctrl+shift+esc': '^+{ESC}', 'win+d': '^{ESC}d',
  'win+l': '^{ESC}l', 'win+e': '^{ESC}e', 'win+r': '^{ESC}r'
};

export async function pressKey(name) {
  const key = String(name || '').trim().toLowerCase();
  if (KEY_MAP[key] !== undefined) return sendKeys(KEY_MAP[key]);
  if (key.startsWith('ctrl+') || key.startsWith('alt+') || key.startsWith('shift+')) {
    const combo = KEY_MAP[key];
    if (combo) return sendKeys(combo);
  }
  if (/^f\d{1,2}$/.test(key)) return sendKeys(`{${key.toUpperCase()}}`);
  if (/^[a-z0-9.,;:!?@#$%&*()_+\-=\/\\|<>"']$/.test(key)) return sendKeys(escapeSendKeys(key));
  return { success: false, output: `❌ مفتاح غير معروف: ${name}. استخدم: /rc key help` };
}

// ── System ──────────────────────────────────────────────────────────────────
const SYSINFO_PS = `
$os = Get-CimInstance Win32_OperatingSystem
$cs = Get-CimInstance Win32_ComputerSystem
$cpu = Get-CimInstance Win32_Processor
$boot = $os.LastBootUpTime
$up = (Get-Date) - $boot
$lines = @()
$lines += "name: " + $cs.Name
$lines += "os: " + $os.Caption + " (build " + $os.BuildNumber + ")"
$lines += "cpu: " + $cpu.Name
$lines += "cores: " + $cpu.NumberOfCores + "/" + $cpu.NumberOfLogicalProcessors
$lines += "ram: " + [math]::Round(($os.TotalVisibleMemorySize/1MB),1) + " GB (free " + [math]::Round(($os.FreePhysicalMemory/1MB),1) + " GB)"
$upStr = "{0}d {1}h {2}m" -f $up.Days, $up.Hours, $up.Minutes
$lines += "uptime: " + $upStr
$lines += "user: " + $env:USERNAME
$ips = (Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue | Where-Object { $_.IPAddress -notlike "127.*" -and $_.IPAddress -notlike "169.254.*" }).IPAddress
$lines += "ip: " + ($ips -join ", ")
$lines | ForEach-Object { Write-Output $_ }
`;

export async function systemInfo() {
  const script = writePsScript('sysinfo.ps1', SYSINFO_PS);
  const result = await runPsFile(script, '', 30000);
  return { success: true, output: result.stdout.trim() || result.stderr.trim() || 'تعذر جلب معلومات النظام' };
}

export const remoteControlCommands = [
  { cmd: '/rc help', desc: 'قائمة الأوامر دي' },
  { cmd: '/rc ss', desc: 'سكرين شوت للشاشة وترجعلك الصورة' },
  { cmd: '/rc info', desc: 'معلومات الجهاز (نظام، رامات، IP...)' },
  { cmd: '/rc ls [مسار]', desc: 'عرض محتويات مجلد (افتراضي: Home)' },
  { cmd: '/rc dl <مسار ملف>', desc: 'تنزيل ملف ليك على الواتساب' },
  { cmd: '/rc run <أمر>', desc: 'تنفيذ أمر CMD وإرجاع النتيجة' },
  { cmd: '/rc ps <سكربت>', desc: 'تنفيذ أمر PowerShell' },
  { cmd: '/rc click <x>,<y>', desc: 'نقرة زر أيسر على إحداثيات الشاشة' },
  { cmd: '/rc double <x>,<y>', desc: 'دبل كليك' },
  { cmd: '/rc right <x>,<y>', desc: 'كليك بزر أيمن' },
  { cmd: '/rc type <نص>', desc: 'كتابة نص في الفورم النشط' },
  { cmd: '/rc key <مفتاح>', desc: 'ضغط زر (Enter, Tab, Esc, Ctrl+C, Win+D...)' },
  { cmd: '/rc lock', desc: 'قفل الشاشة' }
];